# Store all text files with LF line endings in the repo.
# Working copies follow your git settings unless a rule below says otherwise.
* text=auto

# ---------------------------------------------------------------------------
# Unity YAML assets: Unity writes these with LF. Keep LF in the working copy
# too, so git and Unity don't keep converting them back and forth.
# ---------------------------------------------------------------------------
*.unity      text eol=lf
*.prefab     text eol=lf
*.asset      text eol=lf
*.meta       text eol=lf
*.mat        text eol=lf
*.anim       text eol=lf
*.controller text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.playable   text eol=lf
*.mask       text eol=lf
*.brush      text eol=lf
*.flare      text eol=lf
*.fontsettings text eol=lf
*.guiskin    text eol=lf
*.giparams   text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.mixer      text eol=lf
*.shadervariants text eol=lf
*.preset     text eol=lf
*.lighting   text eol=lf
ProjectSettings/ProjectVersion.txt text eol=lf

# Unity package and project config
*.json       text eol=lf
*.asmdef     text eol=lf
*.asmref     text eol=lf

# ---------------------------------------------------------------------------
# Code and mod files
# ---------------------------------------------------------------------------
*.cs         text diff=csharp
*.shader     text
*.cginc      text
*.hlsl       text
*.xml        text
*.md         text
*.txt        text
*.csproj     text eol=crlf
*.sln        text eol=crlf

# ---------------------------------------------------------------------------
# Binary files: never convert or diff as text
# ---------------------------------------------------------------------------
# 3D models
*.fbx        binary
*.obj        binary
*.blend      binary
*.blend1     binary
*.dae        binary
*.3ds        binary
*.max        binary
# Images
*.png        binary
*.jpg        binary
*.jpeg       binary
*.tga        binary
*.psd        binary
*.tif        binary
*.tiff       binary
*.exr        binary
*.hdr        binary
*.dds        binary
*.gif        binary
# Audio
*.wav        binary
*.mp3        binary
*.ogg        binary
# Fonts
*.ttf        binary
*.otf        binary
# Unity binary outputs (asset bundles) and packages
*.unity3d    binary
*.bundle     binary
*.unitypackage binary
# Compiled code
*.dll        binary
*.pdb        binary
*.exe        binary
# Archives
*.zip        binary
*.7z         binary
