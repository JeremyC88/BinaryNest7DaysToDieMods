<configs>
	<append xpath="/items">

		<!-- Carrot: edible, same food values as the vanilla potato. -->
		<item name="foodCropCarrot">
			<property name="Extends" value="foodCropPotato"/>
			<property name="DescriptionKey" value="foodCropCarrotDesc"/>
			<!-- Icon: UIAtlases/ItemIconAtlas/foodCropCarrot.png -->
		</item>

		<!-- Wheat: crafting resource only, not edible raw. Based on the vanilla cotton resource. -->
		<item name="resourceCropWheat">
			<!-- param1 stops it inheriting cotton's CustomIcon, so our own icon is used. -->
			<property name="Extends" value="resourceCropCottonPlant" param1="CustomIcon"/>
			<property name="DescriptionKey" value="resourceCropWheatDesc"/>
			<property name="Group" value="Resources,Food/Cooking"/>
			<!-- Icon: UIAtlases/ItemIconAtlas/resourceCropWheat.png -->
		</item>

	</append>
</configs>
